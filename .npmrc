# Dev dependencies are not optional here: vite, typescript and tailwind are all
# build-time requirements, and `npm run build` fails without them.
#
# An ambient NODE_ENV=production makes npm silently omit them (npm treats
# NODE_ENV=production as --omit=dev), which turns a working checkout into one
# where the build command cannot run. Pinning it makes the install deterministic.
include=dev

# Keep the install reproducible.
save-exact=false
