{
  "name": "patchit",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "description": "Scan your Android apps and see which ones Morphe can patch.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "sync:android": "npm run build && cap sync android",
    "open:android": "cap open android",
    "apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "verify:registry": "esbuild scripts/verify-registry.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=.verify/verify-registry.mjs --log-level=warning && node .verify/verify-registry.mjs",
    "build:seed": "esbuild scripts/build-bundled-snapshot.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=.verify/build-seed.mjs --log-level=warning && node .verify/build-seed.mjs",
    "build:release": "tsc -b && vite build --mode release",
    "verify:theme": "esbuild scripts/verify-theme.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=.verify/verify-theme.mjs --log-level=warning && node .verify/verify-theme.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@material/material-color-utilities": "^0.3.0",
    "idb": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
