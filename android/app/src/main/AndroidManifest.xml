<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      QUERY_ALL_PACKAGES is the whole point of this app: it exists to enumerate
      what is installed and compare it against the patch registry. Android 11
      made package visibility opt-in, so without this the scan sees a handful of
      packages and reports nothing useful.

      This is a Play-policy-sensitive permission, and the justification is worth
      stating plainly: the app has no other way to perform its single stated
      function, and it transmits nothing it reads.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Needed on API 26+ for the "uninstall" action to be permitted at all. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
      Explicit package visibility. QUERY_ALL_PACKAGES covers this on stock
      Android, but declaring the interesting packages keeps `<queries>`
      resolution working on ROMs that treat the blanket permission loosely.
      The Morphe packages are listed so `getPackageInfo` succeeds for them even
      without the blanket permission.
    -->
    <queries>
        <package android:name="app.morphe.manager" />
        <package android:name="app.morphe.manager.debug" />
        <package android:name="app.morphe.patcher" />
        <package android:name="app.revanced.manager" />
        <package android:name="app.revanced.manager.flutter" />

        <!--
          The add-source deep link is the only thing this app sends to Morphe, so
          the https query below is what lets `resolveActivity` see Morphe (and the
          browsers we fall back to) on API 30+.
        -->
        <!-- Used by the store and add-source fallbacks. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

</manifest>
